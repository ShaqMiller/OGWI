# Postgres connection used by Prisma (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://ogwi:ogwi@localhost:5432/ogwi?schema=public"

# HTTP port for the Express API
PORT=4000

# CORS origin allowed to call the API (the Next.js app in dev)
WEB_ORIGIN="http://localhost:3000"

# NOTE: there is no auth provider yet. requireLearner reads a dev header
# (x-dev-learner-id) instead of validating a session. See
# src/middleware/requireLearner.ts for the TODO to replace this.
