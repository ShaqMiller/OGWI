# Base URL of the apps/api Express server. The Next app is a client of this
# API - no business logic lives in Next route handlers.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Dev-only stand-in for a real learner session until an auth provider is
# picked. Forwarded as the x-dev-learner-id header by the BFF proxy.
DEV_LEARNER_ID="dev-learner-1"

# Dev/staging only, and must match the API's setting. Shows the /dev page
# and lets it switch the whole app to a throwaway demo learner.
TEST_CLOCK_ENABLED="false"
