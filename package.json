{
  "name": "ogwi",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm --recursive --filter=./apps/* --filter=./packages/* run build",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "db:migrate": "pnpm --filter @ogwi/api run db:migrate",
    "db:studio": "pnpm --filter @ogwi/api run db:studio",
    "db:seed": "pnpm --filter @ogwi/api run db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
